  fhir:applicability ( [
     fhir:description [ fhir:v "Initial application - Confirmed HIV (Applications from named specialist. Approvals valid without further renewal unless notified)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'ConfirmedHIVInfection')" ]
  ] [
     fhir:description [ fhir:v "Renewal - Confirmed HIV (Applications from named specialist. Approvals valid without further renewal unless notified)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'TreatmentRemainsAppropriate') and exists(Condition where code in 'PatientBenefitingFromTreatment')" ]
  ] [
     fhir:description [ fhir:v "Initial application - Prevention of maternal transmission (Applications from named specialist. Approvals valid for 1 year)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'PreventionOfMaternalFoetalTransmission') or exists(Condition where code in 'TreatmentOfNewbornUpToEightWeeks')" ]
  ] [
     fhir:description [ fhir:v "Initial application - pre-exposure prophylaxis following exposure to HIV (Applications from any relevant practitioner. Approvals valid for 4 weeks)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'TreatmentInitiatedWithin72HoursPostExposure') and (exists(Condition where code in 'CondomlessAnalOrReceptiveVaginalIntercourseWithKnownHIVPositiveVL>200') or exists(Condition where code in 'SharedInjectingEquipmentWithKnownHIVPositive') or exists(Condition where code in 'NonConsensualIntercourseRiskAssessmentIndicatesProphylaxisAppropriate') or exists(Condition where code in 'CondomlessAnalIntercourseWithHighPrevalenceCountryOrRiskGroupStatusUnknown'))" ]
  ] [
     fhir:description [ fhir:v "Renewal - second or subsequent post-exposure prophylaxis (Applications from any relevant practitioner. Approvals valid for 4 weeks)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'TreatmentInitiatedWithin72HoursPostExposure') and (exists(Condition where code in 'CondomlessAnalOrReceptiveVaginalIntercourseWithKnownHIVPositiveVL>200') or exists(Condition where code in 'SharedInjectingEquipmentWithKnownHIVPositive') or exists(Condition where code in 'NonConsensualIntercourseRiskAssessmentIndicatesProphylaxisAppropriate') or exists(Condition where code in 'CondomlessAnalIntercourseWithHighPrevalenceCountryOrRiskGroupStatusUnknown'))" ]
  ] [
     fhir:description [ fhir:v "Initial application - Percutaneous exposure (Applications from named specialist. Approvals valid for 6 weeks)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'PercutaneousExposureToHIVPositiveBlood')" ]
  ] [
     fhir:description [ fhir:v "Renewal - Second or subsequent percutaneous exposure (Applications from named specialist. Approvals valid for 6 weeks)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'PercutaneousExposureToHIVPositiveBlood')" ]
  ] ) . # 

