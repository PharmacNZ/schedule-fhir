<https://fhir-ig.digital.health.nz/pharmac-schedules/ChargeItemDefinition/ChargeItemDefinition-Tenofovir-Emtricitabine-SA2139-Authorization> a fhir:ChargeItemDefinition ;
  fhir:id [ fhir:v "ChargeItemDefinition-SA2139-Authorization"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "https://fhir-ig.digital.health.nz/pharmac-schedules/StructureDefinition/pharmac-charge-item-definition"^^xsd:anyURI ;
       fhir:l <https://fhir-ig.digital.health.nz/pharmac-schedules/StructureDefinition/pharmac-charge-item-definition>
     ] )
  ] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "https://fhir-ig.digital.health.nz/pharmac-schedules/StructureDefinition/pricing-effective-date"^^xsd:anyURI ;
       fhir:l <https://fhir-ig.digital.health.nz/pharmac-schedules/StructureDefinition/pricing-effective-date>
     ] ;
     fhir:value [
       a fhir:Date ;
       fhir:v "2026-03-11"^^xsd:date
     ]
  ] [
     fhir:url [
       fhir:v "https://fhir-ig.digital.health.nz/pharmac-schedules/StructureDefinition/authorization-case-count"^^xsd:anyURI ;
       fhir:l <https://fhir-ig.digital.health.nz/pharmac-schedules/StructureDefinition/authorization-case-count>
     ] ;
     fhir:value [
       a fhir:Integer ;
       fhir:v 7
     ]
  ] ) ; # 
  fhir:url [
     fhir:v "https://fhir-ig.digital.health.nz/pharmac-schedules/ChargeItemDefinition/ChargeItemDefinition-SA2139-Authorization"^^xsd:anyURI ;
     fhir:l <https://fhir-ig.digital.health.nz/pharmac-schedules/ChargeItemDefinition/ChargeItemDefinition-SA2139-Authorization>
  ] ; # 
  fhir:version [ fhir:v "1.0"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:publisher [ fhir:v "Pharmac"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "Pharmac" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "https://www.pharmac.govt.nz/about/contact" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "Special Authorization SA2139. Detailed eligibility criteria available via authorization form."] ; # 
  fhir:code [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://pharmac.govt.nz/fhir/sa"^^xsd:anyURI ;
         fhir:l <http://pharmac.govt.nz/fhir/sa>
       ] ;
       fhir:code [ fhir:v "SA2139" ]
     ] ) ;
     fhir:text [ fhir:v "SA2139" ]
  ] ; # 
  fhir:instance ( [
     fhir:l <https://fhir-ig.digital.health.nz/pharmac-schedules/Medication/Medication-Ricovir-Tenofovir> ;
     fhir:reference [ fhir:v "Medication/Medication-Ricovir-Tenofovir" ]
  ] [
     fhir:l <https://fhir-ig.digital.health.nz/pharmac-schedules/Medication/Medication-Viramune-Suspension> ;
     fhir:reference [ fhir:v "Medication/Medication-Viramune-Suspension" ]
  ] ) ; # 
  fhir:applicability ( [
     fhir:description [ fhir:v "Initial application - Confirmed HIV (Applications from named specialist. Approvals valid without further renewal unless notified)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'ConfirmedHIVInfection')" ]
  ] [
     fhir:description [ fhir:v "Renewal - Confirmed HIV (Applications from named specialist. Approvals valid without further renewal unless notified)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'TreatmentRemainsAppropriate') and exists(Condition where code in 'PatientBenefitingFromTreatment')" ]
  ] [
     fhir:description [ fhir:v "Initial application - Prevention of maternal transmission (Applications from named specialist. Approvals valid for 1 year)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'PreventionOfMaternalFoetalTransmission') or exists(Condition where code in 'TreatmentOfNewbornUpToEightWeeks')" ]
  ] [
     fhir:description [ fhir:v "Initial application - pre-exposure prophylaxis following exposure to HIV (Applications from any relevant practitioner. Approvals valid for 4 weeks)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'TreatmentInitiatedWithin72HoursPostExposure') and (exists(Condition where code in 'CondomlessAnalOrReceptiveVaginalIntercourseWithKnownHIVPositiveVL>200') or exists(Condition where code in 'SharedInjectingEquipmentWithKnownHIVPositive') or exists(Condition where code in 'NonConsensualIntercourseRiskAssessmentIndicatesProphylaxisAppropriate') or exists(Condition where code in 'CondomlessAnalIntercourseWithHighPrevalenceCountryOrRiskGroupStatusUnknown'))" ]
  ] [
     fhir:description [ fhir:v "Renewal - second or subsequent post-exposure prophylaxis (Applications from any relevant practitioner. Approvals valid for 4 weeks)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'TreatmentInitiatedWithin72HoursPostExposure') and (exists(Condition where code in 'CondomlessAnalOrReceptiveVaginalIntercourseWithKnownHIVPositiveVL>200') or exists(Condition where code in 'SharedInjectingEquipmentWithKnownHIVPositive') or exists(Condition where code in 'NonConsensualIntercourseRiskAssessmentIndicatesProphylaxisAppropriate') or exists(Condition where code in 'CondomlessAnalIntercourseWithHighPrevalenceCountryOrRiskGroupStatusUnknown'))" ]
  ] [
     fhir:description [ fhir:v "Initial application - Percutaneous exposure (Applications from named specialist. Approvals valid for 6 weeks)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'PercutaneousExposureToHIVPositiveBlood')" ]
  ] [
     fhir:description [ fhir:v "Renewal - Second or subsequent percutaneous exposure (Applications from named specialist. Approvals valid for 6 weeks)." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'PercutaneousExposureToHIVPositiveBlood')" ]
  ] ) . # 

