  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "pharmac-medication-code"] ; # 
  fhir:url [ fhir:v "https://fhir-ig.digital.health.nz/pharmac-schedules/ValueSet/pharmac-medication-code"^^xsd:anyURI] ; # 
