     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'ChildOrAdolescent') and exists(Condition where code in 'UnableToTolerateGoserelin') and exists(Condition where code in 'PrescriptionEndorsedForAdditionalSubsidy')" ]
  ] [
     fhir:description [ fhir:v "Condition (provider): Prescription must be from an authorised prescriber." ] ;
     fhir:language [ fhir:v "text/cql" ] ;
     fhir:expression [ fhir:v "exists(Condition where code in 'AuthorisedPrescriber')" ]
  ] ) ; # 
  fhir:propertyGroup ( [
     fhir:applicability ( [
       fhir:description [ fhir:v "Case 1 - community pharmacy prescription (intolerance to goserelin)" ]
     ] ) ;
     fhir:priceComponent ( [
       fhir:type [ fhir:v "discount" ] ;
       fhir:code [
         fhir:text [ fhir:v "PHARMAC Subsidy" ]
       ] ;
       fhir:amount [
         fhir:value [ fhir:v 221.6 ] ;
         fhir:currency [ fhir:v "NZD" ]
       ]
     ] )
  ] ) . # 

