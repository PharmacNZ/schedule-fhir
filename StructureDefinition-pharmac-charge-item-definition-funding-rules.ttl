       fhir:definition [ fhir:v "The subsidy or reimbursement amount for this funding mechanism. Typically a single component of type 'discount' with code.text 'PHARMAC Subsidy'" ]
     ] [
       fhir:id [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.type" ] ;
       fhir:path [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.type" ] ;
       fhir:short [ fhir:v "Type of price component (typically 'discount' for subsidy)" ] ;
       fhir:definition [ fhir:v "For funding rules, this is typically 'discount' to represent a subsidy or reimbursement amount" ]
     ] [
       fhir:id [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.code" ] ;
       fhir:path [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.code" ] ;
       fhir:short [ fhir:v "Code or label for subsidy" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.code.text" ] ;
       fhir:path [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.code.text" ] ;
       fhir:short [ fhir:v "Text label (e.g., 'PHARMAC Subsidy')" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.amount" ] ;
       fhir:path [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.amount" ] ;
       fhir:short [ fhir:v "Subsidy/reimbursement amount" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.amount.value" ] ;
       fhir:path [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.amount.value" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.amount.currency" ] ;
       fhir:path [ fhir:v "ChargeItemDefinition.propertyGroup.priceComponent.amount.currency" ] ;
       fhir:pattern [
         a fhir:Code ;
         fhir:v "NZD"
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] )
  ] . # 

