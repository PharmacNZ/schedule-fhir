# - resource -------------------------------------------------------------------

<https://fhir-ig.digital.health.nz/pharmac-schedules/SearchParameter/MedicationNameSearchParam> a fhir:SearchParameter ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "MedicationNameSearchParam"] ; # 
  fhir:url [
     fhir:v "https://fhir-ig.digital.health.nz/pharmac-schedules/SearchParameter/medication-name"^^xsd:anyURI ;
     fhir:l <https://fhir-ig.digital.health.nz/pharmac-schedules/SearchParameter/medication-name>
  ] ; # 
  fhir:version [ fhir:v "1.0.1"] ; # 
  fhir:name [ fhir:v "MedicationName"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:date [ fhir:v "2026-04-24T01:18:12+00:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "Pharmac"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "Pharmac" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "https://www.pharmac.govt.nz/about/contact" ]
     ] )
  ] [
     fhir:name [ fhir:v "Pharmac" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "email" ] ;
       fhir:value [ fhir:v "enquiry@pharmac.govt.nz" ] ;
       fhir:use [ fhir:v "work" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "Search for medications by the text representation of the medication code (e.g., 'Gaviscon Infant', 'Acidex oral liquid'). Enables discovery by the full medication name or formulation description."] ; # 
  fhir:code [ fhir:v "name"] ; # 
  fhir:base ( [ fhir:v "Medication"] ) ; # 
  fhir:type [ fhir:v "string"] ; # 
  fhir:expression [ fhir:v "Medication.code.text"] . # 

