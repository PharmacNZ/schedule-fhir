@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://fhir-ig.digital.health.nz/pharmac-schedules/OperationOutcome/APIError-Unauthorised> a fhir:OperationOutcome ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "APIError-Unauthorised"] ; # 
  fhir:issue ( [
     fhir:severity [ fhir:v "error" ] ;
     fhir:code [ fhir:v "suppressed" ] ;
     fhir:details [
       fhir:coding ( [
         fhir:code [ fhir:v "UNAUTHORISED" ]
       ] )
     ] ;
     fhir:diagnostics [ fhir:v "Unauthorised." ]
  ] ) . # 

